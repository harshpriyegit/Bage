# Node.js 24 or newer is required for built-in SQLite.
PORT=3001
DATA_DIR=./data
# For HTTPS production deployments, set NODE_ENV=production in your process manager.
# Secure cookies require HTTPS when NODE_ENV=production.
# Secret code for "Forgot password?" on the sign-in page. Leave unset to disable resets.
RESET_CODE=change-me
